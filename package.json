{
  "name": "jobak",
  "version": "0.1.0",
  "description": "An AI-powered job-matching platform that helps users find highly relevant job opportunities based on their preferences. Integrates with n8n for automated job discovery and AI-based filtering.",
  "keywords": [
    "job-search",
    "ai-job-finder",
    "job-matching",
    "career",
    "employment",
    "remote-jobs",
    "n8n",
    "ai-powered",
    "grok-api",
    "job-recommendation",
    "automation",
    "nextjs",
    "react"
  ],
  "homepage": "https://github.com/jobak-net/jobak#readme",
  "bugs": {
    "url": "https://github.com/jobak-net/jobak/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jobak-net/jobak.git"
  },
  "license": "MIT",
  "author": {
    "name": "Jobak",
    "email": "hamdy@jobak.net"
  },
  "private": false,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "next dev",
    "prepare": "husky",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "scripts": "tsx scripts/cli.ts",
    "db:migrate": "tsx scripts/db/migration.ts",
    "check:workflows": "node scripts/check-workflows.mjs",
    "check:jsonld": "tsx scripts/json-ld-probe.ts",
    "build:emails": "tsx scripts/render-email-logo.mts && node email-templates/build.mjs && tsx scripts/build-email-templates.mts",
    "build:email-logo": "tsx scripts/render-email-logo.mts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.20",
    "jose": "^6.2.12",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "husky": "^9.1.7",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10",
      "next@>=16.0.0 <16.2.5": ">=16.2.5",
      "next@>=16.0.0 <16.2.6": ">=16.2.6",
