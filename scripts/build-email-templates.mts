#!/usr/bin/env node
/**
 * Inlines the generated app email templates into a TypeScript module.
 *
 *   pnpm build:emails
 *
 * ── Why inline them ─────────────────────────────────────────
 * The templates live in `email-templates/app_templates/`, outside `src/`, so
 * Next never bundles them — reading them at runtime with `fs` works locally and
 * then fails on a serverless deploy where only traced files ship. Turning them
 * into a `.ts` module makes them ordinary imports that the bundler follows.
 *
 * Runs after `email-templates/build.mjs`, which is what actually renders the
 * HTML. This only carries the result across the boundary.
 */

import { mkdirSync, readFileSync, writeFileSync } from "node:fs";
import { join } from "node:path";

const SOURCE_DIR = join(process.cwd(), "email-templates", "app_templates");
const OUT_FILE = join(
  process.cwd(),
  "src",
  "backend",
  "modules",
  "auth",
  "infrastructure",
  "email",
  "templates.generated.ts",
);

/** Filename → export name and the subject line that goes with it. */
const TEMPLATES = [
  {
    file: "verify-email.html",
    export: "VERIFY_EMAIL",
    subject: "Confirm your email address for Jobak",
  },
  {
    file: "reset-password.html",
    export: "RESET_PASSWORD",
    subject: "Reset your Jobak password",
  },
] as const;

/**
 * Must match the cid: the sender substitutes into {{logo}}, and the content_id
 * it puts on the attachment. One name, relied on in three places.
 */
const LOGO_CONTENT_ID = "jobak-logo";

const logoDataUri: string = JSON.parse(
  readFileSync(join(process.cwd(), "email-templates", "logo.b64.json"), "utf8"),
).dataUri;

const PREFIX = "data:image/png;base64,";
if (!logoDataUri.startsWith(PREFIX)) {
  throw new Error(
    `logo.b64.json dataUri does not start with "${PREFIX}". ` +
      `Regenerate it with pnpm build:email-logo.`,
  );
}

/*
 * The prefix is stripped deliberately. Resend wants the base64 payload alone;
 * handing it the whole data URI yields an attachment that decodes to nothing.
 */
const logoBase64 = logoDataUri.slice(PREFIX.length);

/*
 * The same bytes, also written to public/ so they have a URL.
 *
 * A CID attachment is the default because it needs no hosting, but Resend
 * warns that inline images "may be rejected by some clients (especially
 * webmail)" — and Gmail is webmail, which is where the logo kept coming up
 * empty. A hosted image is what Gmail actually renders reliably, since it
 * proxies and displays remote images by default.
 *
 * Generated rather than committed by hand: this file and the attachment must
 * be the same mark, and a PNG copied into public/ once would quietly go stale
 * the first time the brand changed.
 */
const PUBLIC_LOGO_DIR = join(process.cwd(), "public", "email");
mkdirSync(PUBLIC_LOGO_DIR, { recursive: true });
writeFileSync(
  join(PUBLIC_LOGO_DIR, "logo.png"),
  Buffer.from(logoBase64, "base64"),
);

/**
 * The brand mark as a CID attachment, emitted alongside the templates.
 *
 * Travels with the message instead of sitting in the HTML. Gmail does not
 * render data: URIs at all — which is why the logo was invisible there — so
 * the img src is a cid: reference and these bytes are what it points at.
 */
const logoExport = `export const LOGO_ATTACHMENT = {
  contentId: ${JSON.stringify(LOGO_CONTENT_ID)},
  filename: "jobak-logo.png",
  contentType: "image/png",
  base64: ${JSON.stringify(logoBase64)},
} as const;`;

/** Escapes a string for a TypeScript template literal. */
const escape = (html: string) =>
  html.replace(/\\/g, "\\\\").replace(/`/g, "\\`").replace(/\$\{/g, "\\${");

const parts = TEMPLATES.map((t) => {
  const html = readFileSync(join(SOURCE_DIR, t.file), "utf8");

  if (!html.includes("{{link}}")) {
    throw new Error(
      `${t.file} has no {{link}} placeholder — the sender would mail a button that goes nowhere.`,
    );
  }

  if (!html.includes("{{logo}}")) {
    throw new Error(
      `${t.file} has no {{logo}} placeholder — the sender would mail a broken image.`,
    );
  }

  return `export const ${t.export} = {
  subject: ${JSON.stringify(t.subject)},
  html: \`${escape(html)}\`,
} as const;`;
});

const output = `/**
 * GENERATED FILE — DO NOT EDIT.
 *
 * Produced by scripts/build-email-templates.mts from the HTML in
 * email-templates/app_templates/, which is itself generated by
 * email-templates/build.mjs.
 *
 * To change an email: edit email-templates/build.mjs, then run
 *   node email-templates/build.mjs && pnpm build:emails
 */

${parts.join("\n\n")}

${logoExport}
`;

writeFileSync(OUT_FILE, output, "utf8");
console.log(
  `Inlined ${TEMPLATES.length} templates (${output.length} bytes) -> ${OUT_FILE}`,
);
